{
  "info": {
    "name": "Project Management System API",
    "description": "API documentation for Project Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/projects",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Redesign\",\n  \"description\": \"Redesign company website\"\n}"
            }
          }
        },
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/projects?page=1&limit=10"
          }
        },
        {
          "name": "Get Single Project",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/projects/1"
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/projects/1"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/projects/1/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design Homepage\",\n  \"description\": \"Create mockups\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"due_date\": \"2026-05-20\"\n}"
            }
          }
        },
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/projects/1/tasks?status=todo&sort=due_date"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/1/tasks/update",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\"\n}"
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/1/tasks/delete"
          }
        }
      ]
    }
  ]
}
